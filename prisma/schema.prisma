generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum UserRole {
  USER
  ADMIN
}

enum CarStatus {
  AVAILABLE
  UNAVAILABLE
  SOLD
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TestDriveStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PlanType {
  STARTER
  PRO
  ENTERPRISE
}

enum OnboardingSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum MemberRole {
  OWNER
  MEMBER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  PENDING
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

// What a payment pays for.
enum PaymentPurpose {
  SIGNUP // the first period; creates the dealership
  RENEWAL // the next period, from the end of the current one
  UPGRADE // a higher plan, from today
}

enum PaymentStatus {
  PENDING // checkout started, no result yet
  PAID
  FAILED
  EXPIRED // abandoned; never paid
  REFUNDED
}

enum AuditAction {
  // Organization
  ORG_CREATED
  ORG_UPDATED
  ORG_DELETED
  ORG_SUSPENDED
  ORG_ACTIVATED
  // Membership
  MEMBER_INVITED
  MEMBER_ACCEPTED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  // Subscription
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_RENEWED
  // Car
  CAR_CREATED
  CAR_UPDATED
  CAR_DELETED
  CAR_STATUS_CHANGED
  CAR_FEATURED_TOGGLED
  // Test Drive
  TEST_DRIVE_CREATED
  TEST_DRIVE_CONFIRMED
  TEST_DRIVE_CANCELED
  TEST_DRIVE_COMPLETED
  // User
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_DELETED
  // Settings
  WORKING_HOURS_UPDATED
  ORG_SETTINGS_UPDATED
  // Impersonation
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED
}

enum EntityType {
  ORGANIZATION
  USER
  CAR
  TEST_DRIVE
  MEMBERSHIP
  SUBSCRIPTION
  WORKING_HOURS
  IMPERSONATION_SESSION
}

// ============ MULTI-TENANCY MODELS ============

model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logo        String?
  email       String?
  phone       String?
  address     String?
  website     String?
  description String?
  isActive    Boolean   @default(true)

  // Location fields for platform discovery and filtering.
  //
  // Canonical values from lib/locations, never display names: `region` holds an
  // egydata governorate code ("CAI"), `city` an English-derived slug ("maadi"),
  // `country` an ISO country code. They are compared by equality and rendered
  // through lib/locations/names, so a dealer switching the site to Arabic sees
  // their own address change language.
  city        String?
  region      String?
  country     String?   @default("EG")

  // Pending owner invitation (email of user who should become owner when they sign up)
  pendingOwnerEmail String?

  // Branding & Settings
  theme    Json? // { primaryColor, secondaryColor, etc. }
  settings Json? // Feature flags, preferences

  // Rating & Reviews (denormalized for efficient querying)
  // Dealership-wide terms a buyer asks about, set once in settings and true of
  // every car it sells. Null means "not stated", as on the car's own fields.
  offersFinancing  Boolean?
  financingNote    String? // banks, years, down payment — the dealer's words
  acceptsTradeIn   Boolean?
  allowsInspection Boolean? // an independent mechanic may look at the car
  offersDelivery   Boolean?

  averageRating Float @default(0)
  totalReviews  Int   @default(0)

  // Relationships
  subscription          Subscription?
  memberships           Membership[]
  cars                  Car[]
  workingHours          WorkingHours[]
  testDrives            TestDrive[]
  auditLogs             AuditLog[]
  impersonationSessions ImpersonationSession[]
  dealershipReviews     DealershipReview[]
  aiUsage               AiUsage[]
  buyerQuestions        BuyerQuestion[]
  assistantAnswers      AssistantAnswer[]
  digestSends           DigestSend[]
  payments              Payment[]
  billingNotices        BillingNotice[]

  // Emails to the dealership (the weekly summary) are written in this
  // language: "ar" or "en". Arabic by default — the market is Egypt.
  emailLocale         String  @default("ar")
  // The owners get a weekly summary email unless the dealership turns it off.
  weeklyDigestEnabled Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete timestamp

  @@index([slug])
  @@index([isActive])
  @@index([averageRating])
  @@index([city])
  // The dealership listing and the car city facet both filter on the location
  // columns together; only `city` was indexed, so the governorate half of every
  // such query was a scan.
  @@index([country, region, city])
  @@index([isActive, deletedAt])
}

model Plan {
  id   String   @id @default(uuid())
  name String // "Starter", "Pro", "Enterprise"
  type PlanType @unique

  // Pricing in EGP piasters (1 EGP = 100), the unit Paymob charges in.
  monthlyPrice Int @default(0)
  yearlyPrice  Int @default(0)

  // Free-trial length granted when a subscription is created. 0 = no trial.
  trialDays Int @default(0)

  // Limits
  maxCars            Int @default(10)
  maxMembers         Int @default(1)
  maxImagesPerCar    Int @default(5)
  auditLogRetentionDays Int? // null = unlimited

  // Features (JSON for flexibility)
  features Json // { aiProcessing: { enabled, limit }, analytics, chat, etc. }

  isActive             Boolean        @default(true)
  subscriptions        Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingPlan")
  payments             Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan         @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIALING)

  // Billing Period. AutoMe keeps the calendar itself (Paymob is paid through
  // a link each period): see lib/services/billing/periods.ts.
  billingPeriod      BillingPeriod @default(MONTHLY)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  canceledAt         DateTime?

  // A downgrade (or a switch of billing period) waits for the paid period to
  // end; the renewal then charges and applies these.
  pendingPlanId        String?
  pendingPlan          Plan?          @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  pendingBillingPeriod BillingPeriod?
  // Canceled by the owner: keeps the plan until the period ends, then drops
  // to the free plan instead of asking for a renewal.
  cancelAtPeriodEnd    Boolean        @default(false)
  // When the unpaid renewal turned the subscription PAST_DUE.
  pastDueSince         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role MemberRole @default(MEMBER)

  // Invitation tracking
  invitedById String?
  invitedBy   User?     @relation("InvitedMemberships", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedAt   DateTime?
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
}

// ============ AUDIT & IMPERSONATION ============

model AuditLog {
  id             String      @id @default(uuid())
  action         AuditAction
  entityType     EntityType
  entityId       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Actor info
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail      String?
  // During a support session: the member the admin was signed in as (userId
  // is then the admin). metadata.impersonationSessionId names the session.
  impersonatedBy String?

  // Change tracking
  oldValue Json?
  newValue Json?
  metadata Json? // Additional context (IP, userAgent, reason, etc.)

  // Retention
  retainUntil DateTime? // null = keep forever (Enterprise)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([retainUntil])
}

model ImpersonationSession {
  id           String   @id @default(uuid())
  superAdminId String
  superAdmin   User     @relation("SuperAdminSessions", fields: [superAdminId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("ImpersonatedSessions", fields: [targetUserId], references: [id], onDelete: Cascade)

  targetOrganizationId String
  organization         Organization @relation(fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  reason               String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Request metadata
  ipAddress String?
  userAgent String?

  @@index([superAdminId])
  @@index([targetUserId])
  @@index([targetOrganizationId])
  @@index([startedAt])
}

// ============ USER MODEL ============

model User {
  id            String         @id @default(uuid())
  clerkId       String         @unique
  // Nullable: Clerk supports phone-only and some passwordless signups that
  // carry no email address at all. Postgres permits many NULLs under a unique
  // index, so uniqueness still holds for everyone who does have one.
  email         String?        @unique
  name          String?
  imageUrl      String?
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          UserRole       @default(USER)

  // Relationships
  savedCars     SavedCar[]
  testDrives    TestDrive[]
  memberships   Membership[]

  // Invitation tracking
  invitedMembers Membership[] @relation("InvitedMemberships")

  // Impersonation (for Super Admins)
  superAdminSessions   ImpersonationSession[] @relation("SuperAdminSessions")
  impersonatedSessions ImpersonationSession[] @relation("ImpersonatedSessions")

  // Audit logs
  auditLogs AuditLog[]

  // Onboarding
  onboardingSessions OnboardingSession[]

  // Billing
  payments Payment[]

  // Dealership Reviews
  dealershipReviews DealershipReview[]

  // AI usage
  aiUsage AiUsage[]

  // Buyer questions this user answered as a dealership member.
  answeredBuyerQuestions BuyerQuestion[]
}

// ============ CAR MODEL ============

model Car {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  make          String
  model         String
  year          Int
  price         Decimal
  // Currency of record for `price`. AutoMe is Egypt-only, so this is always
  // "EGP" today and nothing converts it — the column exists so that a listing
  // carries its own currency rather than inheriting one from a global
  // assumption. Backfilling it after the fact is the expensive part; the column
  // itself is near-free now. See lib/utils/currency.ts.
  priceCurrency String         @default("EGP")
  mileage       Int
  fuelType      String
  transmission  String
  color         String
  seats         Int?
  bodyType      String
  featured      Boolean        @default(false)
  status        CarStatus      @default(AVAILABLE)
  images        String[]
  title         String?
  description   String?

  // Bilingual listing copy, written by the vision model at extraction time and
  // editable by the dealer. Nullable and additive: `title`/`description` above
  // stay the source of record, so a car created before this existed still
  // renders. `resolveCarTitle`/`resolveCarDescription` in lib/utils/car-text.ts
  // pick per locale and fall back rather than showing a reader a blank.
  //
  // All four feed the searchVector — see the 20260922160000 migration. Text
  // that is not an argument to car_search_document cannot be searched.
  titleEn       String?
  titleAr       String?
  descriptionEn String?
  descriptionAr String?

  location      String?
  features      String[]
  // The Arabic feature list, beside `features` (which stays the English source
  // of record). Written by the vision model, editable by the dealer; resolved
  // per locale by `resolveCarFeatures`. Feeds the searchVector too.
  featuresAr    String[]
  // Alt text per image, written by the model after a save, in both languages:
  // { [imageUrl]: { en, ar } }. Keyed by URL, not by position — updateCarFull
  // reorders and deletes images, which would silently misalign a parallel
  // array. Absent for a URL means "not described yet"; the gallery then falls
  // back to "Make Model — image n". Not searchable by design: it describes
  // photos, and matching "rear view" in search would be noise.
  imageAlts     Json?

  // What a buyer asks before anything else, stated by the dealer. Every one is
  // nullable on purpose, and null means "not stated" — never "no". A listing
  // saying nothing about accidents is not a listing claiming there were none,
  // and the buyer assistant declines rather than guessing either way.
  originalPaint     Boolean? // "فابريكا": no panel repainted
  accidentFree      Boolean?
  ownerCount        Int? // owners the car has had, 1 = first owner
  serviceHistory    ServiceHistory?
  priceNegotiable   Boolean?
  licenseValidUntil DateTime? @db.Date // the month the licence runs to

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Full-text search vector. The GENERATED-ALWAYS expression is defined in the
  // 20260806120000_add_car_search migration (Prisma can't express it), so this
  // is declared Unsupported and populated entirely by the database.
  searchVector  Unsupported("tsvector")?

  savedBy       SavedCar[]
  testDrive     TestDrive[]
  buyerQuestions BuyerQuestion[]
  assistantAnswers AssistantAnswer[]

  @@index([organizationId])
  @@index([make, model])
  @@index([price])
  @@index([year])
  @@index([fuelType])
  @@index([status])
  @@index([color])
  @@index([featured])
  @@index([bodyType])
  // Tier 2 search indexes (see 20260806120000_add_car_search migration).
  @@index([searchVector], type: Gin)
  @@index([make(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([model(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ============ WORKING HOURS ============

model WorkingHours {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek[]
  openTime  String
  closeTime String
  isOpen    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, organizationId])
  @@index([organizationId])
  @@index([isOpen])
  @@index([dayOfWeek])
}

// ============ SAVED CAR ============

model SavedCar {
  id        String   @id @default(uuid())
  userId    String
  carId     String
  createdAt DateTime @default(now())
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@index([userId])
  @@index([carId])
}

// ============ TEST DRIVE ============

model TestDrive {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status    TestDriveStatus @default(PENDING)
  date      DateTime        @db.Date
  startTime String
  endTime   String
  notes     String?
  userId    String
  carId     String
  car       Car             @relation(fields: [carId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([carId])
  @@index([status])
  @@index([date])
}

// ============ ONBOARDING SESSION ============

model OnboardingSession {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  status    OnboardingSessionStatus @default(PENDING)
  expiresAt DateTime
  payments  Payment[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// ============ PAYMENTS ============

// One row per checkout attempt through Paymob; the PAID rows are the
// dealership's invoice history. `id` is sent to Paymob as `special_reference`
// and comes back on the transaction callback as `merchant_order_id`.
//
// Nothing here cascades away: a payment is a financial record and outlives
// the dealership, the onboarding session and the user who paid.
model Payment {
  id String @id @default(uuid())

  // A sign-up payment has no organization until it is paid: it carries the
  // onboarding session the organization is created from.
  organizationId      String?
  organization        Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  onboardingSessionId String?
  onboardingSession   OnboardingSession? @relation(fields: [onboardingSessionId], references: [id], onDelete: SetNull)
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  planId        String
  plan          Plan           @relation(fields: [planId], references: [id])
  billingPeriod BillingPeriod
  purpose       PaymentPurpose

  // What was charged, in piasters. The callback must match both exactly.
  amountCents Int
  currency    String        @default("EGP")
  status      PaymentStatus @default(PENDING)

  // Paymob's ids: the intention's order, and the transaction that paid it.
  providerOrderId       String?
  providerTransactionId String? @unique
  method                String? // "card", "wallet"
  maskedPan             String? // last four digits, as Paymob reports them

  // The period this payment bought, set when it is paid.
  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([onboardingSessionId])
  @@index([status])
}

// ============ DEALERSHIP REVIEW ============

model DealershipReview {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating     Int
  title      String?
  comment    String?
  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([isApproved])
  @@index([rating])
}

// ============ WEBHOOKS ============

// Idempotency ledger for incoming provider webhooks (Paymob, Clerk).
// `id` is the provider's own event id, so a duplicate delivery collides on the PK.
model WebhookEvent {
  id          String   @id // provider event id (Paymob "<transaction id>:<outcome>", Svix `msg_...`)
  provider    String // "paymob" | "clerk" ("stripe" on rows from before Paymob)
  type        String
  processedAt DateTime @default(now())

  @@index([provider])
  @@index([type])
}

// ============ AI USAGE ============

// One row per AI provider call (Gemini today). Replaces the fake
// AuditLog(action="CAR_CREATED") proxy that plan-limits.js counted as AI usage.
//
// `organizationId` is nullable by design: public marketplace search has no tenant
// (mirrors AuditLog.organizationId). It is always sourced server-side from ctx /
// getCurrentOrganization(), never from client input.
model AiUsage {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  feature  String // "carListingFromImage" | "searchFiltersFromText" | "searchFiltersFromImage"
  provider String @default("google")
  model    String

  inputTokens    Int @default(0) // promptTokenCount
  outputTokens   Int @default(0) // candidatesTokenCount
  thinkingTokens Int @default(0) // thoughtsTokenCount (billed separately by Google)
  cachedTokens   Int @default(0) // cachedContentTokenCount
  costMicroUsd   Int @default(0) // 0 on the free tier; kept for a future paid key

  latencyMs Int
  success   Boolean  @default(true)
  errorCode String?
  createdAt DateTime @default(now())

  // The car this call helped save, set when the dealer saves it. A plan's AI
  // allowance counts distinct cars, not calls: the photo read, translation and
  // coach advice for one car are one use. No relation on purpose — deleting
  // the car must not hand the use back.
  carId String?

  @@index([organizationId, feature, createdAt]) // monthly per-org quota count
  @@index([feature, createdAt]) // per-feature reporting
  @@index([createdAt]) // platform-wide RPD/RPM breaker, all features
}

enum ServiceHistory {
  FULL // every service documented
  PARTIAL
  NONE
}

enum BuyerQuestionStatus {
  OPEN
  ANSWERED
  DISMISSED
}

// A question a buyer asked the listing assistant that the listing could not
// answer. The dealer sees it in their inbox; their answer becomes a fact the
// assistant cites for every later buyer ("the dealer says…").
//
// No buyer identity is stored — no user, no IP. Repeats of the same question
// on the same car fold into one row (questionKey) and raise askCount, which is
// what tells the dealer which gaps matter.
model BuyerQuestion {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // The car it was asked on. An answer marked appliesToAllCars is still
  // anchored here, but is cited on every car of the dealership.
  carId          String
  car            Car          @relation(fields: [carId], references: [id], onDelete: Cascade)

  question    String // as first asked, trimmed, at most 300 characters
  questionKey String // folded form, for recognising a repeat
  locale      String // the page language it was asked in
  askCount    Int      @default(1)
  lastAskedAt DateTime @default(now())

  status           BuyerQuestionStatus @default(OPEN)
  answer           String?
  appliesToAllCars Boolean             @default(false)
  answeredById     String?
  answeredBy       User?               @relation(fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([carId, questionKey])
  @@index([organizationId, status, lastAskedAt]) // the dealer's inbox
  @@index([organizationId, status, appliesToAllCars]) // dealership-wide answers
}

// An answer the listing assistant gave a buyer, kept so the buyer can rate it.
// A 👎 also files the question in the dealer's Buyer Questions inbox, where
// the dealer's answer becomes a fact the assistant cites next time. No buyer
// identity is stored; rows older than 90 days are pruned on the next answer
// for the same car.
model AssistantAnswer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  carId          String
  car            Car          @relation(fields: [carId], references: [id], onDelete: Cascade)

  question String // the question as it stands alone, at most 300 characters
  answer   String // what the buyer was shown, at most 600 characters
  locale   String

  helpful Boolean? // null until rated; rated once
  ratedAt DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, helpful, createdAt]) // what buyers found unhelpful
  @@index([carId, createdAt]) // pruning per car
}

// One weekly summary email per dealership per week. The row is claimed
// (inserted) before anything is sent, and the unique pair is what makes a
// cron that fires twice — or retries — send one email, not two. A send that
// fails outright deletes its row so the next run can try again.
model DigestSend {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // The Saturday (Cairo) the summarised week starts on.
  weekStart      DateTime     @db.Date
  // How many owners it reached; 0 until sent.
  recipients     Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, weekStart])
}

// The billing emails the daily renewals job sends, each claimed once per
// subscription period, so a re-run or a retry does not email twice.
model BillingNotice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // "renewal_due" | "renewal_reminder" | "past_due" | "downgraded"
  kind           String
  // The end of the period the email is about.
  periodEnd      DateTime
  createdAt      DateTime     @default(now())

  @@unique([organizationId, kind, periodEnd])
}
