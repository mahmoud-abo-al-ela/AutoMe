generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum UserRole {
  USER
  ADMIN
}

enum CarStatus {
  AVAILABLE
  UNAVAILABLE
  SOLD
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TestDriveStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PlanType {
  STARTER
  PRO
  ENTERPRISE
}

enum OnboardingSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum MemberRole {
  OWNER
  MEMBER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  PENDING
}

enum AuditAction {
  // Organization
  ORG_CREATED
  ORG_UPDATED
  ORG_DELETED
  ORG_SUSPENDED
  ORG_ACTIVATED
  // Membership
  MEMBER_INVITED
  MEMBER_ACCEPTED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  // Subscription
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_RENEWED
  // Car
  CAR_CREATED
  CAR_UPDATED
  CAR_DELETED
  CAR_STATUS_CHANGED
  CAR_FEATURED_TOGGLED
  // Test Drive
  TEST_DRIVE_CREATED
  TEST_DRIVE_CONFIRMED
  TEST_DRIVE_CANCELED
  TEST_DRIVE_COMPLETED
  // User
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_DELETED
  // Settings
  WORKING_HOURS_UPDATED
  ORG_SETTINGS_UPDATED
  // Impersonation
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED
}

enum EntityType {
  ORGANIZATION
  USER
  CAR
  TEST_DRIVE
  MEMBERSHIP
  SUBSCRIPTION
  WORKING_HOURS
  IMPERSONATION_SESSION
}

// ============ MULTI-TENANCY MODELS ============

model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logo        String?
  email       String?
  phone       String?
  address     String?
  website     String?
  description String?
  isActive    Boolean   @default(true)

  // Location fields for platform discovery and filtering
  city        String?
  region      String?
  country     String?   @default("EG")

  // Pending owner invitation (email of user who should become owner when they sign up)
  pendingOwnerEmail String?

  // Branding & Settings
  theme    Json? // { primaryColor, secondaryColor, etc. }
  settings Json? // Feature flags, preferences

  // Rating & Reviews (denormalized for efficient querying)
  averageRating Float @default(0)
  totalReviews  Int   @default(0)

  // Relationships
  subscription          Subscription?
  memberships           Membership[]
  cars                  Car[]
  workingHours          WorkingHours[]
  testDrives            TestDrive[]
  auditLogs             AuditLog[]
  impersonationSessions ImpersonationSession[]
  dealershipReviews     DealershipReview[]
  aiUsage               AiUsage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete timestamp

  @@index([slug])
  @@index([isActive])
  @@index([averageRating])
  @@index([city])
  @@index([isActive, deletedAt])
}

model Plan {
  id   String   @id @default(uuid())
  name String // "Starter", "Pro", "Enterprise"
  type PlanType @unique

  // Pricing (in cents)
  monthlyPrice Int @default(0)
  yearlyPrice  Int @default(0)

  // Stripe Integration
  stripeProductId      String? @unique
  stripeMonthlyPriceId String? @unique
  stripeYearlyPriceId  String? @unique

  // Limits
  maxCars            Int @default(10)
  maxMembers         Int @default(1)
  maxImagesPerCar    Int @default(5)
  auditLogRetentionDays Int? // null = unlimited

  // Features (JSON for flexibility)
  features Json // { aiProcessing: { enabled, limit }, analytics, chat, etc. }

  isActive      Boolean        @default(true)
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan         @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIALING)

  // Stripe Integration
  stripeCustomerId        String? @unique
  stripeSubscriptionId    String? @unique
  stripeCheckoutSessionId String? @unique

  // Billing Period
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role MemberRole @default(MEMBER)

  // Invitation tracking
  invitedById String?
  invitedBy   User?     @relation("InvitedMemberships", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedAt   DateTime?
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
}

// ============ AUDIT & IMPERSONATION ============

model AuditLog {
  id             String      @id @default(uuid())
  action         AuditAction
  entityType     EntityType
  entityId       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Actor info
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail      String?
  impersonatedBy String? // Super Admin ID if impersonating

  // Change tracking
  oldValue Json?
  newValue Json?
  metadata Json? // Additional context (IP, userAgent, reason, etc.)

  // Retention
  retainUntil DateTime? // null = keep forever (Enterprise)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([retainUntil])
}

model ImpersonationSession {
  id           String   @id @default(uuid())
  superAdminId String
  superAdmin   User     @relation("SuperAdminSessions", fields: [superAdminId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("ImpersonatedSessions", fields: [targetUserId], references: [id], onDelete: Cascade)

  targetOrganizationId String
  organization         Organization @relation(fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  reason               String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Request metadata
  ipAddress String?
  userAgent String?

  @@index([superAdminId])
  @@index([targetUserId])
  @@index([targetOrganizationId])
  @@index([startedAt])
}

// ============ USER MODEL ============

model User {
  id            String         @id @default(uuid())
  clerkId       String         @unique
  email         String         @unique
  name          String?
  imageUrl      String?
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          UserRole       @default(USER)

  // Relationships
  savedCars     SavedCar[]
  testDrives    TestDrive[]
  memberships   Membership[]

  // Invitation tracking
  invitedMembers Membership[] @relation("InvitedMemberships")

  // Impersonation (for Super Admins)
  superAdminSessions   ImpersonationSession[] @relation("SuperAdminSessions")
  impersonatedSessions ImpersonationSession[] @relation("ImpersonatedSessions")

  // Audit logs
  auditLogs AuditLog[]

  // Onboarding
  onboardingSessions OnboardingSession[]

  // Dealership Reviews
  dealershipReviews DealershipReview[]

  // AI usage
  aiUsage AiUsage[]
}

// ============ CAR MODEL ============

model Car {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  make          String
  model         String
  year          Int
  price         Decimal
  mileage       Int
  fuelType      String
  transmission  String
  color         String
  seats         Int?
  bodyType      String
  featured      Boolean        @default(false)
  status        CarStatus      @default(AVAILABLE)
  images        String[]
  title         String?
  description   String?
  location      String?
  features      String[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  savedBy       SavedCar[]
  testDrive     TestDrive[]

  @@index([organizationId])
  @@index([make, model])
  @@index([price])
  @@index([year])
  @@index([fuelType])
  @@index([status])
  @@index([color])
  @@index([featured])
  @@index([bodyType])
}

// ============ WORKING HOURS ============

model WorkingHours {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek[]
  openTime  String
  closeTime String
  isOpen    Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, organizationId])
  @@index([organizationId])
  @@index([isOpen])
  @@index([dayOfWeek])
}

// ============ SAVED CAR ============

model SavedCar {
  id        String   @id @default(uuid())
  userId    String
  carId     String
  createdAt DateTime @default(now())
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@index([userId])
  @@index([carId])
}

// ============ TEST DRIVE ============

model TestDrive {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status    TestDriveStatus @default(PENDING)
  date      DateTime        @db.Date
  startTime String
  endTime   String
  notes     String?
  userId    String
  carId     String
  car       Car             @relation(fields: [carId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([carId])
  @@index([status])
  @@index([date])
}

// ============ ONBOARDING SESSION ============

model OnboardingSession {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  status    OnboardingSessionStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

// ============ DEALERSHIP REVIEW ============

model DealershipReview {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating     Int
  title      String?
  comment    String?
  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([isApproved])
  @@index([rating])
}

// ============ WEBHOOKS ============

// Idempotency ledger for incoming provider webhooks (Stripe, Clerk).
// `id` is the provider's own event id, so a duplicate delivery collides on the PK.
model WebhookEvent {
  id          String   @id // provider event id (e.g. Stripe `evt_...`, Svix `msg_...`)
  provider    String // "stripe" | "clerk"
  type        String
  processedAt DateTime @default(now())

  @@index([provider])
  @@index([type])
}

// ============ AI USAGE ============

// One row per AI provider call (Gemini today). Replaces the fake
// AuditLog(action="CAR_CREATED") proxy that plan-limits.js counted as AI usage.
//
// `organizationId` is nullable by design: public marketplace search has no tenant
// (mirrors AuditLog.organizationId). It is always sourced server-side from ctx /
// getCurrentOrganization(), never from client input.
model AiUsage {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  feature  String // "carListingFromImage" | "searchFiltersFromText" | "searchFiltersFromImage"
  provider String @default("google")
  model    String

  inputTokens    Int @default(0) // promptTokenCount
  outputTokens   Int @default(0) // candidatesTokenCount
  thinkingTokens Int @default(0) // thoughtsTokenCount (billed separately by Google)
  cachedTokens   Int @default(0) // cachedContentTokenCount
  costMicroUsd   Int @default(0) // 0 on the free tier; kept for a future paid key

  latencyMs Int
  success   Boolean  @default(true)
  errorCode String?
  createdAt DateTime @default(now())

  @@index([organizationId, feature, createdAt]) // monthly per-org quota count
  @@index([feature, createdAt]) // per-feature reporting
  @@index([createdAt]) // platform-wide RPD/RPM breaker, all features
}
